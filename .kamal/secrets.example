# Template for `.kamal/secrets` (the real file is gitignored).
#
# Kamal reads `.kamal/secrets` at deploy time and resolves each `$VAR` from the
# environment. Two ways to satisfy them:
#
# - CI (.github/workflows/deploy.yml): each var is set from a GitHub Secret.
# - Local deploys: export each var in your shell (or use direnv) before `kamal`.

# Registry — CI passes secrets.GITHUB_TOKEN through as KAMAL_REGISTRY_PASSWORD.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Turso remote database.
TURSO_PRIMARY_URL=$TURSO_PRIMARY_URL
TURSO_AUTH_TOKEN=$TURSO_AUTH_TOKEN

# Playtomic tenant ID the fetcher pulls matches for.
TENANT_ID=$TENANT_ID

# Web session cookie signing key. Generate once with: openssl rand -hex 32
WEB_SESSION_SECRET=$WEB_SESSION_SECRET

# TOTP encryption key — MUST be exactly 32 chars (AES-256).
WEB_TOTP_ENCRYPTION_KEY=$WEB_TOTP_ENCRYPTION_KEY
