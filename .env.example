# .env.example
# Copy this file to .env for local development and fill in real values.
# .env is gitignored and must not be committed.
#
# In production these are injected by Kamal (see config/deploy.yml and
# .kamal/secrets.example), not from a .env file.

# --- Playtomic ---
# The Playtomic tenant/club the fetcher pulls matches for.
TENANT_ID="b8fe7430-f819-4413-b402-a008f94fc2b5"

# --- Application ---
# Port for the web server.
PORT="8080"
# Local database file name. Unused in remote (Turso) mode, where the
# connection comes entirely from TURSO_PRIMARY_URL below.
DB_NAME="club"

# --- Turso (database) ---
# Leave TURSO_PRIMARY_URL empty to use a local SQLite file (DB_NAME) instead.
TURSO_PRIMARY_URL="libsql://[DATABASE].turso.io"
TURSO_AUTH_TOKEN="..."

# --- Web UI auth ---
# Session cookie signing key (32+ chars). Generate: openssl rand -hex 32
WEB_SESSION_SECRET=""
# TOTP encryption key — MUST be exactly 32 chars (AES-256).
WEB_TOTP_ENCRYPTION_KEY=""

# --- Logging ---
# Log format: "json" (default) or "text" (nicer for local dev).
LOG_FORMAT="text"
# Log level: "debug", "info" (default), "warn", or "error".
LOG_LEVEL="info"
